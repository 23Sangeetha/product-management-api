      "name": "Product List Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"baseUrl\", pm.environment.get(\"baseUrl\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let product = pm.response.json();\n\npm.environment.set(\"productId\", product.id);\n\nlet productIds = pm.environment.get(\"productIds\") || \"\";\nproductIds = productIds\n    ? productIds + \",\" + product.id\n    : product.id;\n\npm.environment.set(\"productIds\", productIds);\n\nlet total = pm.environment.get(\"totalProducts\");\npm.environment.set(\"totalProducts\", total + 1);"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disabledSystemHeaders": {
          "content-type": true
        }
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sony WH-1000XM6 Headphones\",\n  \"price\": 39999,\n  \"category\": \"Electronics\",\n  \"stock\": 18\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products"
          ]
        }
      },
